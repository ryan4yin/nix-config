#!/usr/bin/env bash
# Generated by the nix-config-umu-game skill -- run a tool in this prefix.
#   umu-sandbox ~/Games/<name>/exec <exe-or-tool> [args...]    e.g. winecfg
set -euo pipefail
# The host must never execute this game-writable file: launch it with
# `umu-sandbox <this file>`, as the desktop entry does. This check only catches
# mistakes; the sandbox is the boundary.
if [ "${UMU_SANDBOX:-}" != 1 ]; then
  echo "run this inside the umu sandbox: umu-sandbox $0" >&2
  exit 1
fi
export WINEPREFIX=@WINEPREFIX@
DEFAULT_PROTONPATH=@PROTONPATH@
export PROTONPATH="${PROTONPATH:-${UMU_PROTONPATH:-$DEFAULT_PROTONPATH}}"
export GAMEID=@GAMEID@
# Bare wine tools are not executables on disk; run them through Proton wine.
case "${1:-}" in
  winecfg|wineboot|explorer|regedit|control|uninstaller|taskmgr)
    exec umu-run "$PROTONPATH/files/bin/wine" "$@" ;;
  *)
    exec umu-run "$@" ;;
esac
