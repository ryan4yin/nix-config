# just is a command runner; Justfile is like Makefile but simpler.
# The agenix operations run against the private secrets repository at ~/codes/nix-secrets.
# Uses nushell:  nix shell nixpkgs#just nixpkgs#nushell
set shell := ["nu", "-c"]
set working-directory := "../../codes/nix-secrets"

identity := "/etc/ssh/ssh_host_ed25519_key"

# List all recipes
default:
    @just --list --justfile {{justfile()}}

# Edit or create a secret (interactive); pipe the plaintext to write non-interactively
edit file:
    sudo -E agenix -i {{identity}} -e {{quote(file)}}

# Re-encrypt every secret after adding or changing a recipient key
[confirm("Re-encrypt every secret in ~/codes/nix-secrets?")]
rekey:
    sudo -E agenix -r -i {{identity}}
    sudo chown -R ryan:ryan *
